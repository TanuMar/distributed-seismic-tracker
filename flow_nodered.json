    {
        "id": "dd59e26c8dbf47dd",
        "type": "mqtt in",
        "z": "44cb8fdafae3021b",
        "name": "Entrada MQTT Terremotos General",
        "topic": "terremotos/#",
        "qos": "1",
        "datatype": "json",
        "broker": "broker_mosquitto_local",
        "nl": false,
        "rap": true,
        "rh": 0,
