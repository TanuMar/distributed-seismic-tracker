    {
        "id": "49acc6b4d2801d79",
        "type": "function",
        "z": "01dd48a4ed26ad4c",
        "name": "Procesar Magnitud y Tiempo",
        "func": "var d = msg.payload;\n\n// Verificar que sea un payload de seísmo válido\nif (d && d.coordenadas) {\n    var lat = d.coordenadas[1];\n    var lon = d.coordenadas[0];\n    var mag = d.magnitud;\n    var lugar = d.lugar;\n    var tiempo = d.tiempo;\n    \n    // Salida para indicador visual (Gauge)\n    var msgGauge = { payload: mag };\n    \n    // Salida para texto lugar\n    var msgLugar = { payload: lugar };\n\n    // Salida para texto tiempo\n    var msgTiempo = { payload: tiempo };\n\n    return [msgLugar, msgTiempo, msgGauge];\n}\nreturn null;",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 260,
        "y": 140,
        "wires": [
            [],
            [],
            []
        ]
    },
