        ]
    },
    {
        "id": "a6ef69f396d7b2ef",
        "type": "function",
        "z": "44cb8fdafae3021b",
        "name": "Procesar Coordenadas y Mas Fuerte",
        "func": "const MAX_MARKERS = 200;\n\nvar d = msg.payload;\n\n// Verificar que sea un payload de seísmo válido\nif (d && d.coordenadas) {\n    var lat = d.coordenadas[1];\n    var lon = d.coordenadas[0];\n    var mag = d.magnitud;\n    var lugar = d.lugar;\n    var timestamp = d.tiempo;\n    \n    // Salida estructurada para mapas (worldmap o ui)\n    var msgMap = {\n        payload: {\n            name: lugar,\n            lat: lat,\n            lon: lon,\n            icon: \"globe\",\n            iconColor: mag >= 5.0 ? \"red\" : (mag >= 3.0 ? \"orange\" : \"green\"),\n            layer: \"Terremotos\",\n            Magnitud: mag,\n            Timestamp: timestamp\n        }\n    };\n\n    // Eliminar puntos mapa viejos\n    let markers = flow.get(\"markers\") || [];\n\n    // Evitar duplicados por id\n    if (!markers.some(m => m.id === d.id)) {\n        markers.push(d);\n    }\n\n    if (markers.length > MAX_MARKERS) {\n        let oldest = markers.shift();\n        node.send([null, null, null,\n            { payload: { name: oldest.lugar, deleted: true } }\n        ]);\n    }\n    flow.set(\"markers\", markers);\n\n    // Buscar Máximo terremoto de los guardados\n    let maxTerremoto = markers.reduce((max, current) => current.magnitud > max.magnitud ? current : max);\n    var msgTextLugar = { payload: maxTerremoto.lugar };\n    var msgTextTiempo = { payload: maxTerremoto.tiempo };\n    var msgMag = { payload: maxTerremoto.magnitud };\n\n    // Tabla\n    var msgTable = {\n        payload: markers.map(t => ({\n        Lugar: t.lugar,\n        Magnitud: t.magnitud,\n        Timestamp: t.tiempo,\n        Latitud: t.coordenadas[1],\n        Longitud: t.coordenadas[0]\n        }))\n    };\n\n    return [msgTextLugar, msgTextTiempo, msgMag, msgMap,msgTable];\n}\nreturn null;",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 40,
        "wires": [
